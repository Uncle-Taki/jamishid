# Optional for standalone API use; required for APP_ROLE=worker.
# Compose supplies private-network database/Redis URLs automatically.
DATABASE_URL=postgres://jamshid:jamshid-local@localhost:5432/jamshid?sslmode=disable
REDIS_URL=redis://localhost:6379/0
APP_ROLE=api
# APP_ROLE=worker runs three durable page handlers instead of the HTTP API.
CATEGORY_CATALOG_PATH=
